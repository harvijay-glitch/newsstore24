    { "source": "/entity/module/(.*)", "destination": "https://newsstore24.com/", "permanent": true },
    { "source": "/club/label/(.*)", "destination": "https://newsstore24.com/", "permanent": true },
    { "source": "/rubric/detail/(.*)", "destination": "https://newsstore24.com/", "permanent": true },
    { "source": "/hierarchy/project/(.*)", "destination": "https://newsstore24.com/", "permanent": true }
