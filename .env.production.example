# Frontend (Vercel)
VITE_API_URL=https://api.newsstore24.com

# Backend (Render)
PORT=10000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/news-portal?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
APP_URL=https://newsstore24.com
PUBLIC_SITE_URL=https://newsstore24.com
FRONTEND_URL=https://newsstore24.com
OPENROUTER_SITE_URL=https://newsstore24.com

GNEWS_API_KEY=your_gnews_key
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT_MS=20000
NEWS_DAILY_TIMEZONE=Asia/Kolkata
GNEWS_FETCH_SIZE=50

OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_MS=60000
