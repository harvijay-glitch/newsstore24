MONGO_URI=mongodb://127.0.0.1:27017/news-portal
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_NAME=INKL Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_12_character_or_longer_password
GNEWS_API_KEY=your_gnews_key
OPENROUTER_API_KEY=your_openrouter_key
# Must be an OpenRouter model with the :free suffix.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT_MS=20000
NEWS_DAILY_TIMEZONE=Asia/Kolkata
GNEWS_FETCH_SIZE=50
# Optional AI cover generation. Images are persisted in MongoDB GridFS.
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_MS=60000
